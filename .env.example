# TAURA Tesbihçilik — ortam değişkenleri ÖRNEĞİ.
# Gerçek değerleri `.env.local` dosyasına (git'e girmez) ya da sunucunun ortam ayarlarına yazın.
# Bu dosyaya GERÇEK anahtar, parola ya da bağlantı bilgisi YAZMAYIN; yalnız örnektir.

# Veritabanı (varsayılan: mongodb://127.0.0.1:27017/taura). Canlıda kullanıcı/parola içerir.
# MONGODB_URI=mongodb://127.0.0.1:27017/taura

# Sitenin yayındaki tam adresi (e-posta ve ödeme bağlantıları için). Canlıda https olmalı.
# SITE_URL=http://localhost:3000

# Arama motorlarına açık mı? Demo sürümü kapalıdır; canlıda on.
# SITE_INDEXING=off

# Yüklenen görsellerin klasörü (varsayılan ./media).
# MEDIA_DIR=./media

# E-posta: log (varsayılan) = e-posta gönderilmez, yalnız yönetimde kaydedilir.
# MAIL_TRANSPORT=log

# Kartla ödeme: boş = kapalı | fake = yalnız yerel deneme sayfası | iyzico
# PAYMENT_PROVIDER=iyzico
# iyzico anahtarları (deneme/sandbox anahtarları "sandbox-" ile başlar).
# IYZICO_API_KEY=sandbox-xxxxxxxx
# IYZICO_SECRET_KEY=xxxxxxxx
# Boş bırakın: anahtara göre sandbox ya da canlı iyzico adresi seçilir.
# IYZICO_BASE_URL=
